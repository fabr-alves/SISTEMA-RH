rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'fabricio@csva.com.br';
    }

    function isCorporateUser() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[a-zA-Z0-9._-]+@csva[.]com[.]br$');
    }

    function ownsAccessRequest(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidPendingRequest(userId) {
      return ownsAccessRequest(userId)
        && isCorporateUser()
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'status',
          'requestedAt',
          'requestedAtIso'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending';
    }

    function hasApprovedAccess() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/access_requests/$(request.auth.uid))
        && get(/databases/$(database)/documents/access_requests/$(request.auth.uid)).data.status == 'approved';
    }

    match /access_requests/{userId} {
      allow create: if isValidPendingRequest(userId);
      allow read: if isAdmin() || ownsAccessRequest(userId);
      allow update: if isAdmin()
        || (
          isValidPendingRequest(userId)
          && resource.data.status != 'approved'
        );
      allow delete: if isAdmin();
    }

    match /sistema_rh_dados/{documentId} {
      allow read, write: if isAdmin() || hasApprovedAccess();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
